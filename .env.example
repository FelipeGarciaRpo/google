# Copy this file to .env.local and fill in the values.

# Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Convex (database)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Any long random string, also set it in the Convex dashboard
CONVEX_INTERNAL_KEY=

# AI: Google Gemini (free tier at https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=

# AI: Groq, free fallback models (https://console.groq.com)
GROQ_API_KEY=

# AI: your own model behind an OpenAI-compatible API (optional)
# Ollama example: CUSTOM_AI_BASE_URL=http://localhost:11434/v1  CUSTOM_AI_MODEL=my-model
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_LABEL=

# Firecrawl (lets the agent read web pages, optional)
FIRECRAWL_API_KEY=

# Sentry (error tracking, optional)
SENTRY_AUTH_TOKEN=
